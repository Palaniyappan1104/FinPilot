# ==============================================================================
# FinPilot Backend Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM Configuration (Phase 2+)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=3
LLM_INITIAL_RETRY_DELAY=0.5
LLM_BACKOFF_FACTOR=2.0

# Financial Data Providers (Phase 6+)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Database Configuration (Phase 14+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finpilot

# Vector Store / ChromaDB Configuration (Phase 9+)
CHROMA_PERSIST_DIRECTORY=./chroma_data
